.vscode/

# Misc
*.iml
.idea/

# macOS custom folder icon
Icon?

# Private product notes
/PRODUCT_DIRECTION.md

# Private working notes (versioned locally; only README is tracked)
/notes/*
!/notes/README.md

# 루트 md는 전부 로컬 전용 (README 2종만 git에 올림)
/*.md
!/README.md
!/README.ko.md

# Firebase / Google config (local only)
**/GoogleService-Info.plist
**/GoogleService-Info*.plist
**/google-services.json
**/*firebase-admin*.json
**/*firebase-adminsdk*.json
**/*service-account*.json
**/*credentials*.json

# Local environment (keep *.example templates in git)
**/.env*
!**/.env.example
!**/.env*.example

# API secrets
**/secrets/

# Private keys, certificates, and provisioning files
**/*.pem
**/*.key
**/*.p8
**/*.p12
**/*.jks
**/*.keystore
**/*.mobileprovision
