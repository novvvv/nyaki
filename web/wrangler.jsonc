// Cloudflare Workers 설정. `npm run deploy`가 이 파일을 읽는다.
//
// NEXT_PUBLIC_* 환경 변수는 **빌드할 때** 코드에 박힌다. 로컬에서 배포하면
// .env.local 값이 그대로 들어가니, 배포 전에 운영 값인지 확인한다.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nyaki-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // nyaki.kr을 이 앱의 주소로 쓴다. 배포할 때 Cloudflare가 DNS 레코드와
  // https 인증서를 만든다. www.nyaki.kr은 Cloudflare 리다이렉트 규칙으로
  // 여기로 넘긴다.
  "routes": [{ "pattern": "nyaki.kr", "custom_domain": true }]
}
